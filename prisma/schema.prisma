generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id             String   @id @default(uuid())
  startedAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now()) @updatedAt
  ipAddress      String?
  userAgent      String?
  referrer       String?
  landingUrl     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  maxScrollDepth Int      @default(0)
  timeOnPageSec  Int?
  deviceType     String?

  leads  Lead[]
  events Event[]

  @@map("sessions")
}

model Lead {
  id             String    @id @default(uuid())
  sessionId      String?
  session        Session?  @relation(fields: [sessionId], references: [id])

  nome           String
  email          String
  telefone       String
  empresa        String
  segmento       String
  faturamento    String
  cnpj           String?
  investiria     String?
  qualified      Boolean   @default(false)

  webhookSentAt  DateTime?
  webhookStatus  Int?
  whatsappSentAt DateTime?

  redirectUrl    String?
  ipAddress      String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  referrer       String?

  createdAt      DateTime  @default(now())

  @@map("leads")
}

model Event {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])

  type      String
  data      Json?
  ts        DateTime @default(now())

  @@index([sessionId])
  @@index([type])
  @@map("events")
}

// Cliques em anúncio por dia/campanha, vindos da API da plataforma de mídia
// (ex: Meta Insights). Alimenta o Connect Rate = sessions.utmCampaign / clicks.
// "campaign" guarda o ID da campanha (não o nome) — é isso que o UTM real usa
// aqui (utm_campaign={{campaign.id}}), confirmado direto no banco de sessions.
// "campaignName" é só o nome legível, pra exibição no dashboard.
model AdClick {
  id           String   @id @default(uuid())
  date         DateTime
  platform     String
  campaign     String
  campaignName String?
  clicks       Int

  @@unique([date, platform, campaign])
  @@index([campaign])
  @@map("ad_clicks")
}
