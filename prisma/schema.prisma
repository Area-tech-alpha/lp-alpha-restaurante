generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id             String   @id @default(uuid())
  startedAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now()) @updatedAt
  ipAddress      String?
  userAgent      String?
  referrer       String?
  landingUrl     String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  maxScrollDepth Int      @default(0)
  timeOnPageSec  Int?
  deviceType     String?

  leads        Lead[]
  events       Event[]
  partialLeads PartialLead[]

  @@map("sessions")
}

model Lead {
  id             String    @id @default(uuid())
  sessionId      String?
  session        Session?  @relation(fields: [sessionId], references: [id])

  nome           String
  email          String
  telefone       String
  empresa        String
  segmento       String
  faturamento    String
  cnpj           String?
  investiria     String?
  qualified      Boolean   @default(false)

  webhookSentAt  DateTime?
  webhookStatus  Int?
  whatsappSentAt DateTime?

  redirectUrl    String?
  ipAddress      String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  referrer       String?

  createdAt      DateTime  @default(now())

  @@map("leads")
}

model Event {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])

  type      String
  data      Json?
  ts        DateTime @default(now())

  @@index([sessionId])
  @@index([type])
  @@map("events")
}

// Cliques em anúncio por dia/campanha, vindos da API da plataforma de mídia
// (ex: Meta Insights). Alimenta o Connect Rate = sessions.utmCampaign / clicks.
// "campaign" guarda o ID da campanha (não o nome) — é isso que o UTM real usa
// aqui (utm_campaign={{campaign.id}}), confirmado direto no banco de sessions.
// "campaignName" é só o nome legível, pra exibição no dashboard.
model AdClick {
  id           String   @id @default(uuid())
  date         DateTime
  platform     String
  campaign     String
  campaignName String?
  clicks       Int

  @@unique([date, platform, campaign])
  @@index([campaign])
  @@map("ad_clicks")
}

// Captura parcial de e-mail/telefone antes do envio final do formulário
// (Fase 1 da automação de marketing — recuperação de leads). Uma linha por
// sessão: cada onBlur de e-mail/telefone em components/lead-form.tsx dispara
// um upsert aqui via app/actions/submit-partial-lead.ts. "convertedAt" é
// preenchido quando a mesma sessão completa o formulário (ver
// app/actions/submit-lead.ts), pra a automação no n8n filtrar só quem
// abandonou (convertedAt IS NULL) ao montar uma régua de recuperação futura.
model PartialLead {
  id        String   @id @default(uuid())
  sessionId String?  @unique
  session   Session? @relation(fields: [sessionId], references: [id])

  email    String?
  telefone String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  referrer    String?
  ipAddress   String?

  webhookSentAt   DateTime?
  webhookStatus   Int?
  convertedAt     DateTime?
  reminderSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partial_leads")
}
