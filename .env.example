# URL do webhook do CRM que recebe SOMENTE o lead completo, após o submit do
# formulário. Nunca envie capturas parciais para ele: cada uma vira um lead
# sem nome/empresa/segmento/faturamento no CRM.
CRM_WEBHOOK_URL=

# Connection string do Postgres usado pelo Prisma (leads, partial_leads, sessions, events, dashboard).
DATABASE_URL=

# OAuth do Google usado para login no /dashboard (NextAuth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# O ID do Meta Pixel é fixo em lib/meta-pixels.ts (não vem de env). O fbq base fica
# em app/layout.tsx; o evento "Lead" só dispara para leads qualificados (ver
# qualificarLead em app/actions/submit-lead.ts), no pixel e na CAPI.

# Token de acesso (System User, escopo ads_read) e ID da conta de anúncios do
# Meta Ads, usados por app/api/cron/sync-meta-ads para calcular o Connect Rate
# (sessões ÷ cliques no anúncio). Ver lib/meta-ads.ts.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# IDs de campanha do Meta Ads confirmados pelo marketing como dedicados a essa
# LP (separados por vírgula). A conta de anúncios roda campanhas de outros
# produtos/LPs da Alpha também — sem isso, o sync traria cliques de todo mundo.
META_CAMPAIGN_IDS=

# Secret que a Vercel injeta automaticamente como "Authorization: Bearer ..."
# ao chamar os cron jobs definidos em vercel.json — protege o endpoint contra
# chamadas externas não autorizadas.
CRON_SECRET=

# Meta Conversions API (server-side). Token gerado no Gerenciador de Eventos > Pixel >
# Configurações > API de Conversões > "Gerar token de acesso". Sem ele o envio é
# simplesmente ignorado. Ver lib/meta-capi.ts. Tem que ser token do pixel
# 348950488264714 (META_CAPI_TOKEN_348950488264714 também é aceito).
META_CAPI_TOKEN=
# Opcional: código da aba "Testar eventos" (ex: TEST12345). Remover em produção.
META_CAPI_TEST_EVENT_CODE=

# ID do projeto no Microsoft Clarity (clarity.microsoft.com > Settings > Setup).
# Público — vai no HTML. Sem ele o Clarity simplesmente não carrega. Carregado só
# nas páginas públicas da LP (nunca no /dashboard). Ver components/analytics/clarity.tsx.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Token da Clarity Data Export API (Clarity > Settings > Data Export > Generate
# new API token). SECRETO — só no servidor. Usado por app/api/cron/sync-clarity,
# que guarda 1 snapshot por dia (a API não tem histórico além de 72h).
CLARITY_API_TOKEN=

# --- Agendamento (/lp-09/agendamento) — passo a passo em docs/AGENDAMENTO.md ---
# Service Account do Google Cloud com Domain-Wide Delegation no Workspace. A chave
# vem do JSON da SA ("private_key"); na Vercel pode colar com os "\n" literais.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Agenda impersonada (organizer do evento) e closer do lead no CRM — hoje é a do SDR.
# Teste: calebe.tech@assessorialpha.com | Produção: yoshio.aragao@assessorialpha.com
CLOSER_CALENDAR_EMAIL=calebe.tech@assessorialpha.com
# Inicial de quem atende a reunião. Título do evento:
# "{MEETING_TITLE_PREFIX}: {CLOSER_INITIAL} | {empresa}", ex: "Consultoria: Y | Mestre do Frango"
CLOSER_INITIAL=Y
MEETING_TITLE_PREFIX=Consultoria

# Opcional: chave do token que leva os dados do lead até /lp-09/agendamento
# (lib/agendamento-token.ts). Sem ela, usa o AUTH_SECRET. Trocar invalida os
# links de agendamento ainda não usados.
AGENDAMENTO_TOKEN_SECRET=

# CRM (Dashboard-Comercial-Back-V2) que recebe o lead QUALIFICADO das variações com
# agendamento: entra na Matriz com o closer de CLOSER_CALENDAR_EMAIL no envio do
# form, e a reunião é anexada depois do agendamento (lib/crm.ts). Esse lead não
# vai para o CRM_WEBHOOK_URL/Growth Hub. A chave é a EXTERNAL_LEADS_API_KEY do CRM.
CRM_API_URL=
CRM_EXTERNAL_LEADS_API_KEY=

# Webhook n8n disparado depois que a reunião é criada no Google Agenda (lp-09):
# recebe crm_lead_id, nome_empresa e data/hora da reunião (lib/agendamento-webhook.ts).
# Vazio = só loga e o agendamento segue normalmente.
AGENDAMENTO_WEBHOOK_URL=

# Follow-up do agendamento (lp-09): 5 min depois do envio do form, o QStash chama
# /api/agendamento/followup; se o lead qualificado não agendou, o lead vai para
# COMERCIAL_WEBHOOK_URL (lib/agendamento-followup.ts). Ver docs/AGENDAMENTO.md.
COMERCIAL_WEBHOOK_URL=
# Upstash Console > QStash: token para publicar e as duas chaves de assinatura.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# URL pública do site (sem barra no final), usada como destino do QStash.
# Ex.: https://cadastro.assessorialpha.com
SITE_URL=
