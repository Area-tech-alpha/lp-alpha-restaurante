# Banco de dados (Postgres) usado pra leads e sessões (UTMs)
DATABASE_URL=

# Webhook do CRM (n8n) que recebe o lead ao submeter o formulário.
# Payload enviado via POST em JSON (ver app/actions/submit-lead.ts):
# {
#   "lead_id": string,
#   "nome": string,
#   "email": string,
#   "telefone": string,
#   "empresa": string,
#   "segmento": string,
#   "faturamento": string,
#   "cnpj": string | undefined,
#   "investiria": string | undefined,
#   "origem": "alpha-restaurante"
# }
CRM_WEBHOOK_URL=https://webhook3.assessorialpha.com/webhook/wordpress-geral

# Login do dashboard (NextAuth + Google). Só e-mails @assessorialpha.com passam.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta Pixel (opcional, client-side)
NEXT_PUBLIC_META_PIXEL_ID=
